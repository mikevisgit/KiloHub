{
  "name": "kilo-hub",
  "displayName": "Kilo Hub",
  "description": "Папки Kilo Code: автоматическое обновление, поиск по диалогам и вашим сообщениям.",
  "version": "0.3.0",
  "icon": "resources/kilo-hub.png",
  "publisher": "local",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "npm@11.6.2",
  "engines": {
    "vscode": "^1.105.1",
    "node": ">=22.19.0 <25"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./build/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:kiloHub.folders",
    "onCommand:kiloHub.refresh"
  ],
  "files": [
    "LICENSE.txt",
    "build/*.js",
    "build/webview/*",
    "docs/release-notes.md",
    "resources/**"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kiloHub",
          "title": "Kilo Hub",
          "icon": "resources/hub.svg"
        }
      ]
    },
    "views": {
      "kiloHub": [
        {
          "id": "kiloHub.folders",
          "name": "Kilo Hub",
          "type": "webview",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "kiloHub.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "kiloHub.openHere",
        "title": "Open Here"
      },
      {
        "command": "kiloHub.openNewWindow",
        "title": "Open in New Window"
      },
      {
        "command": "kiloHub.openInFileExplorer",
        "title": "Open in File Explorer"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "kiloHub.refresh",
          "when": "false"
        },
        {
          "command": "kiloHub.openHere",
          "when": "false"
        },
        {
          "command": "kiloHub.openNewWindow",
          "when": "false"
        },
        {
          "command": "kiloHub.openInFileExplorer",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "check-types": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "bundle": "node scripts/build.mjs",
    "verify:webview-bundle": "node scripts/verify-webview-bundle.mjs",
    "build:tests": "tsc -p tsconfig.tests.json",
    "test:unit": "npm run build:tests && node scripts/run-unit-tests.mjs",
    "test:component": "npm run build:tests && node scripts/run-component-tests.mjs",
    "test:integration": "npm run test:integration:min",
    "test:integration:min": "npm run bundle && npm run verify:webview-bundle && npm run build:tests && node scripts/run-extension-tests.mjs 1.105.1",
    "test:integration:current": "npm run bundle && npm run verify:webview-bundle && npm run build:tests && node scripts/run-extension-tests.mjs stable",
    "test:installed": "npm run test:installed:min",
    "test:installed:min": "npm run bundle && npm run build:tests && node scripts/run-installed-extension-tests.mjs 1.105.1",
    "test:installed:current": "npm run bundle && npm run build:tests && node scripts/run-installed-extension-tests.mjs stable",
    "test": "npm run check-types && npm run lint && npm run test:unit && npm run test:component && npm run test:integration",
    "verify:vsix": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-vsix.ps1",
    "test:verify-vsix-negative": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-vsix-verifier.ps1",
    "package": "npm run bundle && node scripts/package.mjs && npm run verify:vsix",
    "package:repro": "node scripts/verify-reproducible-package.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "@types/vscode": "1.105.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "happy-dom": "20.14.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
